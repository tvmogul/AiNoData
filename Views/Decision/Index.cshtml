                audit: []
            };

            function createDimension(name, inputType, source, role, dataType, units, objective, weight, currentValue, safeMin, safeMax, warning, critical, curve, uncertainty, hardConstraint, relationship, explanation) {
                return {
                    id: "dimension-" + Math.random().toString(36).substring(2, 10),
                    name: name,
                    inputType: inputType,
                    source: source,
                    role: role,
                    dataType: dataType,
                    units: units,
                    objective: objective,
                    weight: weight,
                    currentValue: currentValue,
                    safeMin: safeMin,
                    safeMax: safeMax,
                    warning: warning,
                    critical: critical,
                    curve: curve,
                    uncertainty: uncertainty,
                    hardConstraint: hardConstraint,
                    relationship: relationship,
                    explanation: explanation,
                    enabled: true,
                    validated: true
                };
            }

            function cloneObject(value) {
                return JSON.parse(JSON.stringify(value));
            }

            function loadTemplate(templateKey) {
                const template = cloneObject(templates[templateKey]);

                state.templateKey = templateKey;
                state.dimensions = template.dimensions;
                state.actions = template.actions;
                state.selectedId = state.dimensions.length ? state.dimensions[0].id : null;
                state.validated = true;
                state.version = 1;
                state.audit = [];

                document.getElementById("modelVersion").textContent = "Model v1.0";
                addAudit("Loaded application model: " + template.title + ".");
                renderAll();
            }

            function getSelectedDimension() {
                return state.dimensions.find(function (dimension) {
                    return dimension.id === state.selectedId;
                }) || null;
            }

            function getEnabledDimensions() {
                return state.dimensions.filter(function (dimension) {
                    return dimension.enabled;
                });
            }

            function calculateRisk(dimension) {
                const value = Number(dimension.currentValue) || 0;
                let risk = value;

                switch (dimension.objective) {
                    case "Maximize":
                        risk = 1 - value;
                        break;
                    case "Maintain Target":
                        risk = Math.abs(value - ((Number(dimension.safeMin) + Number(dimension.safeMax)) / 2));
                        break;
                    case "Stay Within Range":
                        if (value < Number(dimension.safeMin)) {
                            risk = Number(dimension.safeMin) - value;
                        } else if (value > Number(dimension.safeMax)) {
                            risk = value - Number(dimension.safeMax);
                        } else {
                            risk = 0;
                        }
                        break;
                    case "Prohibit Above Limit":
                    case "Minimize":
                    default:
                        risk = value;
                        break;
                }

                if (dimension.curve === "Nonlinear") {
                    risk = Math.pow(risk, 1.45);
                }

                if (dimension.curve === "Accelerating Risk") {
                    risk = Math.pow(risk, 2) * 1.45;
                }

                if (dimension.curve === "Threshold") {
                    risk = value >= Number(dimension.warning) ? Math.min(1, risk * 1.45) : risk * 0.45;
                }

                if (dimension.curve === "Logistic") {
                    risk = 1 / (1 + Math.exp(-10 * (risk - 0.5)));
                }

                return Math.max(0, Math.min(1, risk));
            }

            function calculateContribution(dimension) {
                return (Number(dimension.weight) / 100) * calculateRisk(dimension);
            }

            function isConstraintViolated(dimension) {
                if (!dimension.enabled || !dimension.hardConstraint) {
                    return false;
                }

                const value = Number(dimension.currentValue) || 0;

                if (dimension.objective === "Maximize") {
                    return value < Number(dimension.warning);
                }

                return value >= Number(dimension.critical);
            }

            function evaluateDecision() {
                const enabledDimensions = getEnabledDimensions();
                const rankedDimensions = enabledDimensions.map(function (dimension) {
                    return {
                        dimension: dimension,
                        contribution: calculateContribution(dimension),
                        violated: isConstraintViolated(dimension)
                    };
                }).sort(function (left, right) {
                    return right.contribution - left.contribution;
                });

                const totalScore = rankedDimensions.reduce(function (sum, result) {
                    return sum + result.contribution;
                }, 0);

                const violation = rankedDimensions.find(function (result) {
                    return result.violated;
                });

                const topResult = rankedDimensions.length ? rankedDimensions[0] : null;
                let recommendedAction = state.actions.length ? state.actions[0] : "Continue";
                let status = "Clear";

                if (violation) {
                    recommendedAction = state.actions[state.actions.length - 1] || "Reject";
                    status = "Constraint Violated";
                } else if (totalScore > 1.30) {
                    recommendedAction = state.actions[2] || state.actions[0] || "Hold";
                    status = "High Risk";
                } else if (totalScore > 0.80) {
                    recommendedAction = state.actions[1] || state.actions[0] || "Review";
                    status = "Caution";
                }

                return {
                    rankedDimensions: rankedDimensions,
                    totalScore: totalScore,
                    violation: violation,
                    topResult: topResult,
                    recommendedAction: recommendedAction,
                    status: status
                };
            }

            function renderAll() {
                renderDimensionList();
                renderSelectedDimension();
                renderSummary();
                renderRelationships();
                renderConstraints();
                renderDecisionSurface();
                renderScenarioControls();
                renderActions();
                renderDeploy();
                renderAudit();
                updateValidationDisplay();
            }

            function renderDimensionList() {
                const list = document.getElementById("dimensionList");
                list.innerHTML = "";

                state.dimensions.forEach(function (dimension) {
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "ds-dimension-item " +
                        (dimension.id === state.selectedId ? "active " : "") +
                        (dimension.validated ? "validated" : "modified");
                    button.dataset.id = dimension.id;

                    button.innerHTML =
                        '<span class="ds-dimension-icon"></span>' +
                        '<span class="ds-dimension-name">' + escapeHtml(dimension.name) +
                        '<span class="ds-dimension-source">' + escapeHtml(dimension.inputType) + '</span></span>' +
                        '<span class="ds-toggle ' + (dimension.enabled ? "enabled" : "") + '"></span>';

                    button.addEventListener("click", function (event) {
                        const toggle = event.target.closest(".ds-toggle");

                        if (toggle) {
                            dimension.enabled = !dimension.enabled;
                            markModified(dimension.name + " " + (dimension.enabled ? "enabled." : "disabled."));
                        } else {
                            state.selectedId = dimension.id;
                        }

                        renderAll();
                    });

                    list.appendChild(button);
                });

                const enabledDimensions = getEnabledDimensions();

                document.getElementById("activeDimensionCount").textContent = enabledDimensions.length;
                document.getElementById("hardConstraintCount").textContent = enabledDimensions.filter(function (dimension) {
                    return dimension.hardConstraint;
                }).length;

                document.getElementById("inputSourceCount").textContent = new Set(enabledDimensions.map(function (dimension) {
                    return dimension.inputType;
                })).size;

                document.getElementById("actionCount").textContent = state.actions.length;
            }

            function renderSelectedDimension() {
                const dimension = getSelectedDimension();

                if (!dimension) {
                    return;
                }

                document.getElementById("dimensionName").value = dimension.name;
                document.getElementById("inputSourceType").value = dimension.inputType;
                document.getElementById("dataSource").value = dimension.source;
                document.getElementById("dimensionRole").value = dimension.role;
                document.getElementById("dataType").value = dimension.dataType;
                document.getElementById("dimensionUnits").value = dimension.units;
                document.getElementById("dimensionObjective").value = dimension.objective;
                document.getElementById("importanceWeight").value = dimension.weight;
                document.getElementById("importanceWeightValue").textContent = (Number(dimension.weight) / 100).toFixed(2);
                document.getElementById("safeMinimum").value = dimension.safeMin;
                document.getElementById("safeMaximum").value = dimension.safeMax;
                document.getElementById("warningThreshold").value = dimension.warning;
                document.getElementById("criticalThreshold").value = dimension.critical;
                document.getElementById("behaviorCurve").value = dimension.curve;
                document.getElementById("uncertaintyTolerance").value = dimension.uncertainty;
                document.getElementById("hardConstraint").checked = dimension.hardConstraint;
                document.getElementById("relationshipRule").value = dimension.relationship;
                document.getElementById("explanationText").value = dimension.explanation;
                document.getElementById("curveDimensionName").textContent = dimension.name;
                document.getElementById("selectedDimensionStatus").textContent = dimension.validated ? "Validated" : "Modified — Validation Required";

                drawDimensionCurve(dimension);
            }

            function renderSummary() {
                const result = evaluateDecision();
                const dimension = getSelectedDimension();
                const selectedContribution = dimension ? calculateContribution(dimension) : 0;
                const equationTerms = getEnabledDimensions().map(function (item) {
                    return (Number(item.weight) / 100).toFixed(2) + "·P(" + abbreviate(item.name) + ")";
                });

                document.getElementById("selectedDimensionEffectLabel").textContent = dimension ? dimension.name + " Contribution" : "Dimension Contribution";
                document.getElementById("dimensionContribution").textContent = "+" + selectedContribution.toFixed(3);
                document.getElementById("liveEquation").innerHTML =
                    "S(a) = " + equationTerms.join(" + ") +
                    "<br />Current Score = " + result.totalScore.toFixed(3);

                document.getElementById("topRiskName").textContent = result.topResult ? result.topResult.dimension.name : "None";
                document.getElementById("decisionScore").textContent = result.totalScore.toFixed(3);

                const constraintStatus = document.getElementById("constraintStatus");
                constraintStatus.textContent = result.status;
                constraintStatus.className = result.violation ? "danger" : (result.status === "Caution" || result.status === "High Risk" ? "warning" : "positive");

                const health = document.getElementById("modelHealth");
                health.textContent = state.validated ? "Stable / Validated" : "Validation Required";
                health.className = state.validated ? "positive" : "warning";

                document.getElementById("recommendedAction").textContent = "Recommended Decision: " + result.recommendedAction;

                if (result.violation) {
                    document.getElementById("decisionExplanation").textContent =
                        result.violation.dimension.explanation + " Hard constraint triggered; selected action changed to " + result.recommendedAction + ".";
                } else if (result.topResult) {
                    document.getElementById("decisionExplanation").textContent =
                        result.topResult.dimension.explanation + " Current recommendation: " + result.recommendedAction + ".";
                }
            }

            function renderRelationships() {
                const list = document.getElementById("relationshipList");
                const relationships = getEnabledDimensions().filter(function (dimension) {
                    return dimension.relationship && dimension.relationship.trim().length > 0;
                });

                list.innerHTML = "";

                relationships.forEach(function (dimension) {
                    const row = document.createElement("div");
                    row.className = "ds-relationship-row";
                    row.innerHTML =
                        "<strong>" + escapeHtml(dimension.name) + "</strong>" +
                        "<span>" + escapeHtml(dimension.relationship) + "</span>";
                    list.appendChild(row);
                });

                const selected = getSelectedDimension();
                document.getElementById("relationshipFormula").textContent =
                    selected
                        ? "I(" + abbreviate(selected.name) + ", related dimensions) = λ × interaction effect"
                        : "Select a dimension to view its interaction term.";
            }

            function renderConstraints() {
                const list = document.getElementById("constraintList");
                const constraints = getEnabledDimensions().filter(function (dimension) {
                    return dimension.hardConstraint;
                });

                list.innerHTML = "";

                if (!constraints.length) {
                    list.innerHTML = '<div class="ds-constraint-row"><span>No hard constraints have been configured.</span></div>';
                    return;
                }

                constraints.forEach(function (dimension) {
                    const row = document.createElement("div");
                    const violation = isConstraintViolated(dimension);
                    row.className = "ds-constraint-row";
                    row.innerHTML =
                        "<strong>" + escapeHtml(dimension.name) + (violation ? " — VIOLATED" : "") + "</strong>" +
                        "<span>" + escapeHtml(dimension.objective) + " | Critical Threshold: " + formatNumber(dimension.critical) + "</span>";
                    list.appendChild(row);
                });
            }

            function renderDecisionSurface() {
                const result = evaluateDecision();
                const equation = getEnabledDimensions().map(function (dimension) {
                    return (Number(dimension.weight) / 100).toFixed(2) + "P" + abbreviate(dimension.name);
                }).join(" + ");

                document.getElementById("fullEquation").innerHTML =
                    "S(a) = " + equation +
                    " + Σ Interaction Terms + Σ Hard Constraints" +
                    "<br />Selected action minimizes acceptable S(a) while preserving validated constraints." +
                    "<br />Current scenario score: " + result.totalScore.toFixed(3);

                drawSurfaceCanvas();
            }

            function renderScenarioControls() {
                const container = document.getElementById("scenarioControls");
                container.innerHTML = "";

                getEnabledDimensions().slice(0, 6).forEach(function (dimension) {
                    const block = document.createElement("div");
                    block.className = "ds-scenario-value";

                    const label = document.createElement("label");
                    label.innerHTML =
                        "<span>" + escapeHtml(dimension.name) + "</span>" +
                        "<strong>" + formatNumber(dimension.currentValue) + "</strong>";

                    const range = document.createElement("input");
                    range.type = "range";
                    range.min = "0";
                    range.max = "1";
                    range.step = "0.01";
                    range.value = dimension.currentValue;
                    range.className = "ds-range";

                    range.addEventListener("input", function () {
                        dimension.currentValue = Number(range.value);
                        label.querySelector("strong").textContent = formatNumber(dimension.currentValue);
                        renderSummary();
                        drawDimensionCurve(getSelectedDimension());
                        drawSurfaceCanvas();
                        renderActions();
                        renderConstraints();
                    });

                    block.appendChild(label);
                    block.appendChild(range);
                    container.appendChild(block);
                });
            }

            function renderActions() {
                const container = document.getElementById("actionCards");
                const result = evaluateDecision();

                container.innerHTML = "";

                state.actions.forEach(function (action) {
                    const card = document.createElement("div");
                    card.className = "ds-action-card " + (action === result.recommendedAction ? "selected" : "");
                    card.innerHTML =
                        "<strong>" + escapeHtml(action) + "</strong>" +
                        "<span>" + (action === result.recommendedAction ? "Selected by active decision surface" : "Candidate action evaluated") + "</span>";
                    container.appendChild(card);
                });
            }

            function renderDeploy() {
                document.getElementById("deployDimensionCount").textContent = getEnabledDimensions().length;
                document.getElementById("deployValidationState").textContent = state.validated ? "Validated" : "Required";
            }

            function renderAudit() {
                const container = document.getElementById("auditHistory");
                container.innerHTML = "";

                state.audit.slice(0, 5).forEach(function (entry) {
                    const row = document.createElement("div");
                    row.className = "ds-audit-row";
                    row.innerHTML =
                        "<time>" + escapeHtml(entry.time) + "</time>" +
                        "<span>" + escapeHtml(entry.text) + "</span>";
                    container.appendChild(row);
                });
            }

            function markModified(message) {
                state.validated = false;
                const dimension = getSelectedDimension();

                if (dimension) {
                    dimension.validated = false;
                }

                addAudit(message);
            }

            function validateModel() {
                state.validated = true;

                state.dimensions.forEach(function (dimension) {
                    dimension.validated = true;
                });

                addAudit("Model validation passed. Configuration ready for deployment.");
                showToast("<strong>Validation Passed</strong><br />Decision model is ready for deployment.");
                renderAll();
            }

            function addDimension() {
                const newDimension = createDimension(
                    "New Decision Dimension",
                    "API / External Feed",
                    "New Input Source",
                    "Context",
                    "Decimal 0-1",
                    "Value",
                    "Minimize",
                    50,
                    0.20,
                    0.00,
                    0.60,
                    0.60,
                    0.80,
                    "Linear",
                    0.10,
                    false,
                    "Define how this input relates to existing dimensions.",
                    "New validated input alters the active decision model."
                );

                newDimension.validated = false;
                state.dimensions.push(newDimension);
                state.selectedId = newDimension.id;

                markModified("New decision dimension added. Validation required.");
                renderAll();
            }

            function removeDimension() {
                const dimension = getSelectedDimension();

                if (!dimension || state.dimensions.length === 1) {
                    showToast("<strong>Unable to Remove</strong><br />A model must contain at least one decision dimension.");
                    return;
                }

                state.dimensions = state.dimensions.filter(function (item) {
                    return item.id !== dimension.id;
                });

                state.selectedId = state.dimensions[0].id;
                markModified("Removed dimension: " + dimension.name + ".");
                renderAll();
            }

            function saveSelectedDimension() {
                const dimension = getSelectedDimension();

                if (!dimension) {
                    return;
                }

                addAudit("Saved dimension configuration: " + dimension.name + ".");
                showToast("<strong>Dimension Saved</strong><br />" + escapeHtml(dimension.name) + " has been saved to the model.");
                renderAll();
            }

            function deployConfiguration() {
                if (!state.validated) {
                    showToast("<strong>Deployment Blocked</strong><br />Validate the modified model before deployment.");
                    return;
                }

                state.version += 1;
                document.getElementById("modelVersion").textContent = "Model v1." + state.version;
                addAudit("Configuration deployed. Core engine recompile required: No.");
                showToast("<strong>Configuration Deployed</strong><br />New inputs are active without core-engine recompilation or AI retraining.");
                renderAll();
            }

            function addAudit(text) {
                const current = new Date();
                state.audit.unshift({
                    time: current.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
                    text: text
                });
            }

            function updateValidationDisplay() {
                const statusText = document.getElementById("modelStatusText");
                const badge = document.getElementById("modelStatusBadge");

                if (state.validated) {
                    statusText.textContent = "Validated";
                    badge.style.color = "var(--ds-success)";
                    badge.style.borderColor = "rgba(46, 207, 141, .25)";
                    badge.style.background = "rgba(46, 207, 141, .10)";
                } else {
                    statusText.textContent = "Modified";
                    badge.style.color = "var(--ds-warning)";
                    badge.style.borderColor = "rgba(245, 190, 85, .28)";
                    badge.style.background = "rgba(245, 190, 85, .10)";
                }
            }

            function drawDimensionCurve(dimension) {
                const canvas = document.getElementById("decisionCurveCanvas");
                const context = canvas.getContext("2d");

                if (!dimension || !context) {
                    return;
                }

                prepareCanvas(canvas, context);

                const width = canvas.clientWidth;
                const height = canvas.clientHeight;
                const padding = 18;

                drawGrid(context, width, height, padding);

                context.beginPath();

                for (let index = 0; index <= 100; index++) {
                    const xValue = index / 100;
                    const tempDimension = Object.assign({}, dimension, { currentValue: xValue });
                    const yValue = calculateContribution(tempDimension);
                    const x = padding + (width - padding * 2) * xValue;
                    const y = height - padding - (height - padding * 2) * Math.min(1, yValue * 1.32);

                    if (index === 0) {
                        context.moveTo(x, y);
                    } else {
                        context.lineTo(x, y);
                    }
                }

                context.strokeStyle = getCssVariable("--ds-accent-bright");
                context.lineWidth = 2.4;
                context.stroke();

                const currentX = padding + (width - padding * 2) * Number(dimension.currentValue);
                const currentY = height - padding - (height - padding * 2) * Math.min(1, calculateContribution(dimension) * 1.32);

                context.beginPath();
                context.arc(currentX, currentY, 5, 0, Math.PI * 2);
                context.fillStyle = getCssVariable("--ds-accent-bright");
                context.fill();
            }

            function drawSurfaceCanvas() {
                const canvas = document.getElementById("surfaceCanvas");
                const context = canvas.getContext("2d");

                if (!context) {
                    return;
                }

                prepareCanvas(canvas, context);

                const width = canvas.clientWidth;
                const height = canvas.clientHeight;
                const padding = 18;
                const dimensions = getEnabledDimensions();

                drawGrid(context, width, height, padding);

                context.beginPath();

                for (let index = 0; index <= 100; index++) {
                    const xValue = index / 100;
                    let score = 0;

                    dimensions.forEach(function (dimension, dimensionIndex) {
                        const shiftedValue = Math.min(1, Math.max(0, xValue + (dimensionIndex * 0.045)));
                        const tempDimension = Object.assign({}, dimension, { currentValue: shiftedValue });
                        score += calculateContribution(tempDimension);
                    });

                    const normalizedScore = Math.min(1, score / Math.max(1, dimensions.length * 0.52));
                    const x = padding + (width - padding * 2) * xValue;
                    const y = height - padding - normalizedScore * (height - padding * 2);

                    if (index === 0) {
                        context.moveTo(x, y);
                    } else {
                        context.lineTo(x, y);
                    }
                }

                context.strokeStyle = getCssVariable("--ds-accent-bright");
                context.lineWidth = 2.5;
                context.stroke();
            }

            function drawGrid(context, width, height, padding) {
                context.strokeStyle = getCssVariable("--ds-border");
                context.lineWidth = 1;

                for (let index = 0; index <= 4; index++) {
                    const y = padding + ((height - padding * 2) / 4) * index;
                    context.beginPath();
                    context.moveTo(padding, y);
                    context.lineTo(width - padding, y);
                    context.stroke();
                }

                for (let index = 0; index <= 5; index++) {
                    const x = padding + ((width - padding * 2) / 5) * index;
                    context.beginPath();
                    context.moveTo(x, padding);
                    context.lineTo(x, height - padding);
                    context.stroke();
                }
            }

            function prepareCanvas(canvas, context) {
                const ratio = window.devicePixelRatio || 1;
                const width = canvas.clientWidth;
                const height = canvas.clientHeight;

                canvas.width = width * ratio;
                canvas.height = height * ratio;

                context.setTransform(ratio, 0, 0, ratio, 0, 0);
                context.clearRect(0, 0, width, height);
            }

            function getCssVariable(name) {
                return getComputedStyle(document.getElementById("decisionEditorRoot")).getPropertyValue(name).trim();
            }

            function abbreviate(name) {
                return name.split(" ").map(function (word) {
                    return word.charAt(0).toUpperCase();
                }).join("");
            }

            function formatNumber(value) {
                return Number(value).toFixed(2);
            }

            function escapeHtml(value) {
                return String(value || "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function showToast(html) {
                const toast = document.getElementById("decisionToast");
                toast.innerHTML = html;
                toast.classList.add("show");

                window.clearTimeout(showToast.timeoutId);
                showToast.timeoutId = window.setTimeout(function () {
                    toast.classList.remove("show");
                }, 3400);
            }

            document.querySelectorAll(".ds-tab").forEach(function (tab) {
                tab.addEventListener("click", function () {
                    document.querySelectorAll(".ds-tab").forEach(function (item) {
                        item.classList.remove("active");
                    });

                    document.querySelectorAll(".ds-panel").forEach(function (panel) {
                        panel.classList.remove("active");
                    });

                    tab.classList.add("active");

                    const selectedPanel = document.getElementById("panel-" + tab.dataset.tab);
                    selectedPanel.classList.add("active");

                    if (tab.dataset.tab === "surface") {
                        drawSurfaceCanvas();
                    }
                });
            });

            document.querySelectorAll("[data-field]").forEach(function (control) {
                const eventName = control.type === "range" ? "input" : "change";

                control.addEventListener(eventName, function () {
                    const dimension = getSelectedDimension();

                    if (!dimension) {
                        return;
                    }

                    const field = control.dataset.field;
                    let value = control.type === "checkbox" ? control.checked : control.value;

                    if (["weight", "safeMin", "safeMax", "warning", "critical", "uncertainty"].includes(field)) {
                        value = Number(value);
                    }

                    dimension[field] = value;
                    dimension.validated = false;
                    state.validated = false;

                    if (field === "weight") {
                        document.getElementById("importanceWeightValue").textContent = (Number(value) / 100).toFixed(2);
                    }

                    renderAll();
                });

                if (control.tagName === "INPUT" && control.type === "text" || control.tagName === "TEXTAREA") {
                    control.addEventListener("input", function () {
                        const dimension = getSelectedDimension();

                        if (!dimension) {
                            return;
                        }

                        dimension[control.dataset.field] = control.value;
                        dimension.validated = false;
                        state.validated = false;
                        renderDimensionList();
                        renderSummary();
                        renderRelationships();
                        updateValidationDisplay();
                    });
                }
            });

            document.getElementById("applicationModel").addEventListener("change", function () {
                loadTemplate(this.value);
            });

            document.getElementById("quickAddDimension").addEventListener("click", addDimension);
            document.getElementById("addDimensionButton").addEventListener("click", addDimension);
            document.getElementById("removeDimensionButton").addEventListener("click", removeDimension);
            document.getElementById("saveDimensionButton").addEventListener("click", saveSelectedDimension);
            document.getElementById("validateModelButton").addEventListener("click", validateModel);

            document.getElementById("addRelationshipButton").addEventListener("click", function () {
                showToast("<strong>Relationship Builder</strong><br />Select a dimension and define its relationship rule in the Dimensions panel.");
            });

            document.getElementById("savePolicyButton").addEventListener("click", function () {
                markModified("Constraint policy updated. Validation required.");
                showToast("<strong>Policy Saved</strong><br />Validate the model before deployment.");
                renderAll();
            });

            document.getElementById("rollbackVersionButton").addEventListener("click", function () {
                loadTemplate(state.templateKey);
                showToast("<strong>Rollback Complete</strong><br />Restored the validated template configuration.");
            });

            document.getElementById("runScenarioButton").addEventListener("click", function () {
                const result = evaluateDecision();
                addAudit("Scenario test completed. Recommended decision: " + result.recommendedAction + ".");
                showToast("<strong>Scenario Test Complete</strong><br />Recommended Decision: " + escapeHtml(result.recommendedAction));
                renderAll();
            });

            document.getElementById("deployConfigurationButton").addEventListener("click", deployConfiguration);

            window.addEventListener("resize", function () {
                const dimension = getSelectedDimension();
                drawDimensionCurve(dimension);

                if (document.getElementById("panel-surface").classList.contains("active")) {
                    drawSurfaceCanvas();
                }
            });

