                        createDimension("Media Cost", "Database Field", "Station Rate Card", "Resource", "Currency", "Cost Index", "Minimize", 78, 0.49, 0.00, 0.55, 0.60, 0.82, "Linear", 0.05, false, "Higher media cost lowers expected profit.", "Media cost reduces placement profitability."),
                        createDimension("Product Margin", "Database Field", "Product Accounting", "Opportunity", "Currency", "Margin Index", "Maximize", 84, 0.72, 0.35, 1.00, 0.00, 0.00, "Linear", 0.02, false, "Margin increases allowable cost per order.", "Product margin supports profitable media purchasing."),
