                        createDimension("GPS Jamming Confidence", "Sensor / Telemetry", "Navigation Interference Detector", "Confidence", "Decimal 0-1", "Confidence", "Minimize", 81, 0.62, 0.00, 0.36, 0.45, 0.75, "Nonlinear", 0.12, true, "Above warning level, increase fallback navigation priority.", "High GPS jamming reduces navigation reliability and promotes validated fallback actions."),
                        createDimension("Communication Link", "Sensor / Telemetry", "Command Link Monitor", "Confidence", "Decimal 0-1", "Link Loss", "Minimize", 66, 0.18, 0.00, 0.36, 0.42, 0.70, "Threshold", 0.08, false, "Link degradation increases autonomous recovery priority.", "Communication degradation changes permitted mission actions.")
                    ]
                },
                stock: {
                    title: "Stock Trading Decision Engine",
                    actions: ["Buy Position", "Hold", "Reduce Position", "Sell Position"],
                    dimensions: [
                        createDimension("Expected Return", "Market Feed", "Fundamental / Forecast Feed", "Opportunity", "Percentage", "% Return", "Maximize", 88, 0.71, 0.30, 1.00, 0.00, 0.00, "Nonlinear", 0.14, false, "Return is discounted as volatility increases.", "Expected return contributes positively when risk remains acceptable."),
                        createDimension("Volatility Risk", "Market Feed", "Options Volatility Feed", "Risk", "Decimal 0-1", "Risk Index", "Minimize", 85, 0.67, 0.00, 0.40, 0.52, 0.78, "Accelerating Risk", 0.11, true, "High volatility reduces acceptable position size.", "High volatility increases downside exposure and may prohibit buying."),
                        createDimension("Earnings Strength", "Database Field", "Financial Statements", "Opportunity", "Decimal 0-1", "Strength", "Maximize", 64, 0.58, 0.30, 1.00, 0.00, 0.00, "Linear", 0.10, false, "Strong earnings increase opportunity value.", "Earnings strength supports an investment action."),
                        createDimension("Price Momentum", "Market Feed", "Price / Volume Feed", "Context", "Decimal 0-1", "Momentum", "Maximize", 54, 0.49, 0.30, 1.00, 0.00, 0.00, "Linear", 0.19, false, "Momentum must be balanced against risk.", "Momentum contributes to action timing."),
                        createDimension("Maximum Exposure", "Rule / Threshold", "Portfolio Rules", "Constraint", "Percentage", "% Portfolio", "Prohibit Above Limit", 100, 0.22, 0.00, 0.25, 0.25, 0.30, "Threshold", 0.00, true, "Exposure constraint overrides buy opportunity.", "The selected action may not exceed portfolio exposure limits.")
