@{
    ViewData["Title"] = "Decision Editor";
    var scriptNonce = Html.ScriptNonce();
}

<style>
    .decision-space {
        --ds-bg: #08121d;
        --ds-panel: #0d1b2a;
        --ds-panel-alt: #122437;
        --ds-panel-soft: #172d43;
        --ds-border: #203c52;
        --ds-text: #e8f0f7;
        --ds-muted: #87a0b5;
        --ds-accent: #17a9df;
        --ds-accent-bright: #29c5f6;
        --ds-success: #2ecf8d;
        --ds-warning: #f5be55;
        --ds-danger: #ef6877;
        --ds-purple: #948cff;
        --ds-shadow: 0 20px 48px rgba(0, 0, 0, .26);
        position: relative;
        left: 50%;
        transform: translateX(-50%);
        width: min(1760px, calc(100vw - 48px));
        max-width: none;
        margin: 0 0 26px 0;
        color: var(--ds-text);
        background: radial-gradient(circle at 15% 0%, rgba(23, 169, 223, .12), transparent 32%), linear-gradient(180deg, #091420 0%, #07111c 100%);
        border: 1px solid var(--ds-border);
        border-radius: 13px;
        overflow: hidden;
        box-shadow: var(--ds-shadow);
        font-size: 13px;
    }

    [data-bs-theme="light"] .decision-space {
        --ds-bg: #f4f7fb;
        --ds-panel: #ffffff;
        --ds-panel-alt: #f5f8fc;
        --ds-panel-soft: #eaf2fb;
        --ds-border: #d4e0eb;
        --ds-text: #152c42;
        --ds-muted: #657c90;
        --ds-accent: #0589cc;
        --ds-accent-bright: #009bd7;
        --ds-success: #14915f;
        --ds-warning: #b57b08;
        --ds-danger: #ca3e4b;
        --ds-purple: #6557d6;
        --ds-shadow: 0 18px 42px rgba(15, 33, 52, .10);
        background: radial-gradient(circle at 15% 0%, rgba(5, 137, 204, .09), transparent 35%), #f4f7fb;
    }

    .ds-topbar {
        display: grid;
        grid-template-columns: 260px minmax(330px, 540px) 230px;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--ds-border);
        background: rgba(8, 18, 29, .42);
    }

    [data-bs-theme="light"] .ds-topbar {
        background: #ffffff;
    }

    .ds-brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ds-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 35px;
        width: 35px;
        border-radius: 8px;
        border: 1px solid rgba(41, 197, 246, .42);
        background: rgba(23, 169, 223, .12);
        color: var(--ds-accent-bright);
        font-weight: 800;
        font-size: 16px;
        letter-spacing: -1px;
    }

    .ds-brand-name {
        font-size: 18px;
        font-weight: 750;
        letter-spacing: .01em;
        line-height: 1.05;
    }

        .ds-brand-name span {
            color: var(--ds-accent-bright);
        }

    .ds-brand-subtitle {
        color: var(--ds-muted);
        font-size: 9px;
        letter-spacing: .09em;
        text-transform: uppercase;
        margin-top: 2px;
    }

    .ds-model-picker {
        display: flex;
        align-items: center;
        gap: 9px;
        width: 100%;
    }

        .ds-model-picker label {
            color: var(--ds-muted);
            white-space: nowrap;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .07em;
        }

        .ds-model-picker select {
            width: 100%;
        }

    .ds-top-status {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
    }

    .ds-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 7px;
        background: rgba(46, 207, 141, .10);
        border: 1px solid rgba(46, 207, 141, .25);
        color: var(--ds-success);
        font-size: 11px;
        font-weight: 700;
    }

    .ds-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .ds-version {
        color: var(--ds-muted);
        font-size: 11px;
    }

    .ds-tabs {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 12px;
        border-bottom: 1px solid var(--ds-border);
        background: var(--ds-panel);
        overflow-x: auto;
    }

    .ds-tab {
        position: relative;
        background: transparent;
        border: 0;
        color: var(--ds-muted);
        padding: 11px 15px 10px 15px;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
        cursor: pointer;
    }

        .ds-tab:hover {
            color: var(--ds-text);
        }

        .ds-tab.active {
            color: var(--ds-accent-bright);
        }

            .ds-tab.active::after {
                content: "";
                position: absolute;
                bottom: -1px;
                left: 9px;
                right: 9px;
                height: 2px;
                border-radius: 4px 4px 0 0;
                background: var(--ds-accent-bright);
            }

    .ds-panel {
        display: none;
    }

        .ds-panel.active {
            display: block;
        }

    .ds-dimensions-layout {
        display: grid;
        grid-template-columns: 235px minmax(690px, 1fr) 315px;
        min-height: 650px;
    }

    .ds-left,
    .ds-center,
    .ds-right {
        padding: 11px;
        min-width: 0;
    }

    .ds-left,
    .ds-center {
        border-right: 1px solid var(--ds-border);
    }

    .ds-left {
        background: rgba(8, 18, 29, .24);
    }

    [data-bs-theme="light"] .ds-left {
        background: #f8fbfe;
    }

    .ds-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 9px;
        color: var(--ds-muted);
        text-transform: uppercase;
        letter-spacing: .09em;
        font-size: 10px;
        font-weight: 750;
    }

        .ds-section-title strong {
            color: var(--ds-text);
            text-transform: none;
            letter-spacing: 0;
            font-size: 13px;
        }

    .ds-mini-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 23px;
        width: 23px;
        border-radius: 6px;
        border: 1px solid var(--ds-border);
        background: var(--ds-panel-alt);
        color: var(--ds-accent-bright);
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
    }

        .ds-mini-button:hover {
            border-color: var(--ds-accent);
        }

    .ds-dimension-list {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-bottom: 9px;
    }

    .ds-dimension-item {
        border: 1px solid transparent;
        border-radius: 7px;
        background: transparent;
        color: var(--ds-text);
        padding: 7px 7px;
        cursor: pointer;
        display: grid;
        grid-template-columns: 9px 1fr auto;
        gap: 7px;
        align-items: center;
        text-align: left;
        width: 100%;
    }

        .ds-dimension-item:hover {
            background: var(--ds-panel-alt);
        }

        .ds-dimension-item.active {
            border-color: rgba(23, 169, 223, .38);
            background: rgba(23, 169, 223, .13);
        }

    .ds-dimension-icon {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--ds-accent-bright);
    }

    .ds-dimension-item.validated .ds-dimension-icon {
        background: var(--ds-success);
    }

    .ds-dimension-item.modified .ds-dimension-icon {
        background: var(--ds-warning);
    }

    .ds-dimension-name {
        font-size: 12px;
        font-weight: 620;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ds-dimension-source {
        display: block;
        color: var(--ds-muted);
        font-size: 10px;
        margin-top: 1px;
        font-weight: 400;
    }

    .ds-toggle {
        height: 16px;
        width: 29px;
        border-radius: 16px;
        background: #31485b;
        position: relative;
        flex-shrink: 0;
    }

        .ds-toggle.enabled {
            background: var(--ds-accent);
        }

        .ds-toggle::before {
            content: "";
            position: absolute;
            height: 12px;
            width: 12px;
            left: 2px;
            top: 2px;
            border-radius: 50%;
            background: #ffffff;
            transition: transform .15s ease;
        }

        .ds-toggle.enabled::before {
            transform: translateX(13px);
        }

    .ds-add-button,
    .ds-primary-button,
    .ds-secondary-button,
    .ds-danger-button {
        border-radius: 6px;
        padding: 7px 11px;
        font-weight: 650;
        border: 1px solid var(--ds-border);
        cursor: pointer;
        background: var(--ds-panel-alt);
        color: var(--ds-text);
        font-size: 12px;
    }

    .ds-add-button {
        display: block;
        width: 100%;
        border-color: rgba(23, 169, 223, .45);
        background: rgba(23, 169, 223, .10);
        color: var(--ds-accent-bright);
        padding: 8px;
    }

        .ds-add-button:hover,
        .ds-primary-button:hover {
            filter: brightness(1.1);
        }

    .ds-primary-button {
        color: #ffffff;
        border-color: var(--ds-accent);
        background: linear-gradient(180deg, #179fdb, #0879bc);
    }

    .ds-danger-button {
        color: var(--ds-danger);
        background: rgba(239, 104, 119, .08);
        border-color: rgba(239, 104, 119, .34);
    }

    .ds-side-card {
        margin-top: 11px;
        padding: 9px;
        border-radius: 7px;
        border: 1px solid var(--ds-border);
        background: var(--ds-panel-alt);
    }

    .ds-side-card-title {
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .ds-small-stat {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 4px 0;
        color: var(--ds-muted);
        font-size: 11px;
    }

        .ds-small-stat strong {
            color: var(--ds-text);
            font-size: 11px;
        }

    .ds-form-grid {
        display: grid;
        grid-template-columns: repeat(4, 170px);
        justify-content: start;
        align-items: start;
        gap: 9px 10px;
        margin-bottom: 10px;
    }

        .ds-form-grid.two {
            grid-template-columns: repeat(2, minmax(170px, 225px));
        }

    .ds-field.full {
        grid-column: span 4;
    }

    .ds-field.two-column,
    .ds-field.ds-span-2 {
        grid-column: span 2;
    }

    .ds-field label {
        display: block;
        color: var(--ds-muted);
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .065em;
        margin-bottom: 4px;
    }

    .ds-input,
    .ds-select,
    .ds-textarea {
        color: var(--ds-text);
        background: var(--ds-panel-alt);
        border: 1px solid var(--ds-border);
        border-radius: 6px;
        padding: 6px 7px;
        width: 100%;
        outline: none;
        font-size: 12px;
        height: 32px;
    }

    .ds-textarea {
        resize: vertical;
        min-height: 50px;
        height: 50px;
    }

        .ds-input:focus,
        .ds-select:focus,
        .ds-textarea:focus {
            border-color: var(--ds-accent);
            box-shadow: 0 0 0 2px rgba(23, 169, 223, .13);
        }

    .ds-range-wrap {
        display: flex;
        align-items: center;
        gap: 7px;
        height: 32px;
    }

    .ds-range {
        flex: 1;
        accent-color: var(--ds-accent-bright);
    }

    .ds-range-value {
        color: var(--ds-accent-bright);
        font-size: 12px;
        font-weight: 700;
        min-width: 38px;
        text-align: right;
    }

    .ds-inline-values {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
    }

    .ds-check-row {
        display: flex;
        align-items: center;
        gap: 7px;
        min-height: 32px;
        color: var(--ds-text);
    }

        .ds-check-row input {
            height: 15px;
            width: 15px;
            accent-color: var(--ds-accent-bright);
        }

    .ds-curve-card {
        width: 710px;
        max-width: 100%;
        border-radius: 8px;
        border: 1px solid var(--ds-border);
        background: var(--ds-panel-alt);
        padding: 9px;
        margin: 8px 0 10px 0;
    }

    .ds-curve-header {
        display: flex;
        justify-content: space-between;
        color: var(--ds-muted);
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .07em;
        margin-bottom: 7px;
    }

    #decisionCurveCanvas,
    #surfaceCanvas {
        display: block;
        width: 100%;
        height: 105px;
        border-radius: 6px;
        background: rgba(0, 0, 0, .11);
    }

    [data-bs-theme="light"] #decisionCurveCanvas,
    [data-bs-theme="light"] #surfaceCanvas {
        background: #f4f8fc;
    }

    .ds-button-row {
        display: flex;
        justify-content: flex-end;
        gap: 7px;
        width: 710px;
        max-width: 100%;
        margin-top: 10px;
    }

    .ds-summary-card {
        border: 1px solid var(--ds-border);
        border-radius: 8px;
        background: var(--ds-panel-alt);
        padding: 10px;
        margin-bottom: 10px;
    }

    .ds-summary-title {
        color: var(--ds-muted);
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 8px;
    }

    .ds-contribution {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 11px;
        color: var(--ds-muted);
        margin-bottom: 7px;
    }

        .ds-contribution strong {
            color: var(--ds-accent-bright);
            font-size: 17px;
            font-weight: 750;
        }

    .ds-formula {
        color: var(--ds-text);
        background: rgba(0, 0, 0, .14);
        border: 1px solid var(--ds-border);
        padding: 8px;
        border-radius: 6px;
        font-family: Consolas, Monaco, monospace;
        font-size: 11px;
        line-height: 1.42;
        overflow-wrap: anywhere;
    }

    [data-bs-theme="light"] .ds-formula {
        background: #f4f8fc;
    }

    .ds-result-row {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
        color: var(--ds-muted);
        font-size: 12px;
    }

        .ds-result-row strong {
            color: var(--ds-text);
        }

        .ds-result-row .positive {
            color: var(--ds-success);
        }

        .ds-result-row .warning {
            color: var(--ds-warning);
        }

        .ds-result-row .danger {
            color: var(--ds-danger);
        }

    .ds-decision-result {
        margin-top: 8px;
        border-radius: 6px;
        border: 1px solid rgba(46, 207, 141, .34);
        background: rgba(46, 207, 141, .10);
        padding: 8px;
        color: var(--ds-success);
        font-size: 12px;
        font-weight: 700;
    }

    .ds-explanation {
        margin-top: 8px;
        color: var(--ds-muted);
        line-height: 1.38;
        font-size: 11px;
    }

    .ds-capability-card {
        border-radius: 8px;
        padding: 9px;
        background: rgba(23, 169, 223, .08);
        border: 1px solid rgba(23, 169, 223, .25);
        margin-bottom: 10px;
    }

        .ds-capability-card strong {
            display: block;
            color: var(--ds-accent-bright);
            margin-bottom: 4px;
            font-size: 12px;
        }

        .ds-capability-card span {
            color: var(--ds-muted);
            font-size: 11px;
            line-height: 1.35;
        }

    .ds-audit-row {
        display: grid;
        grid-template-columns: 65px 1fr;
        gap: 7px;
        border-left: 2px solid var(--ds-accent);
        padding: 2px 0 6px 8px;
        margin-bottom: 6px;
        font-size: 11px;
    }

        .ds-audit-row time {
            color: var(--ds-muted);
        }

        .ds-audit-row span {
            color: var(--ds-text);
        }

    .ds-workspace {
        padding: 12px;
    }

    .ds-workspace-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 11px;
    }

    .ds-wide-card {
        border-radius: 8px;
        border: 1px solid var(--ds-border);
        background: var(--ds-panel);
        padding: 12px;
    }

        .ds-wide-card.full {
            grid-column: 1 / -1;
        }

    .ds-wide-title {
        color: var(--ds-text);
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .ds-wide-subtitle {
        color: var(--ds-muted);
        line-height: 1.38;
        margin-bottom: 10px;
        font-size: 12px;
    }

    .ds-relationship-row,
    .ds-action-card,
    .ds-constraint-row {
        border-radius: 6px;
        border: 1px solid var(--ds-border);
        background: var(--ds-panel-alt);
        padding: 9px;
        margin-bottom: 6px;
    }

        .ds-relationship-row strong,
        .ds-action-card strong,
        .ds-constraint-row strong {
            display: block;
            margin-bottom: 3px;
        }

        .ds-relationship-row span,
        .ds-action-card span,
        .ds-constraint-row span {
            color: var(--ds-muted);
            font-size: 11px;
        }

    .ds-action-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 7px;
    }

    .ds-action-card.selected {
        border-color: rgba(46, 207, 141, .42);
        background: rgba(46, 207, 141, .08);
    }

    .ds-scenario-controls {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .ds-scenario-value {
        border-radius: 7px;
        border: 1px solid var(--ds-border);
        background: var(--ds-panel-alt);
        padding: 8px;
    }

        .ds-scenario-value label {
            display: flex;
            justify-content: space-between;
            color: var(--ds-muted);
            font-size: 11px;
            margin-bottom: 6px;
        }

            .ds-scenario-value label strong {
                color: var(--ds-text);
            }

    .ds-deploy-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
    }

    .ds-deploy-stat {
        border-radius: 7px;
        border: 1px solid var(--ds-border);
        background: var(--ds-panel-alt);
        padding: 10px;
    }

        .ds-deploy-stat span {
            display: block;
            color: var(--ds-muted);
            font-size: 11px;
            margin-bottom: 5px;
        }

        .ds-deploy-stat strong {
            font-size: 18px;
        }

    .ds-toast {
        position: fixed;
        right: 22px;
        bottom: 20px;
        min-width: 290px;
        max-width: 420px;
        border-radius: 8px;
        border: 1px solid rgba(23, 169, 223, .42);
        background: #10283c;
        color: #ffffff;
        padding: 10px 12px;
        box-shadow: 0 14px 34px rgba(0, 0, 0, .34);
        transform: translateY(18px);
        opacity: 0;
        pointer-events: none;
        transition: opacity .16s ease, transform .16s ease;
        z-index: 5000;
    }

        .ds-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .ds-toast strong {
            color: var(--ds-accent-bright);
        }

    @@media (max-width: 1410px) {
        .decision-space {
            width: calc(100vw - 34px);
        }

        .ds-dimensions-layout {
            grid-template-columns: 220px minmax(535px, 1fr) 288px;
        }

        .ds-form-grid {
            grid-template-columns: repeat(3, 160px);
        }

        .ds-field.full {
            grid-column: span 3;
        }

        .ds-curve-card,
        .ds-button-row {
            width: 500px;
        }
    }

    @@media (max-width: 1090px) {
        .ds-topbar {
            display: flex;
            flex-wrap: wrap;
        }

        .ds-model-picker {
            order: 3;
            flex: 1 1 100%;
        }

        .ds-dimensions-layout {
            grid-template-columns: 220px minmax(480px, 1fr);
        }

        .ds-right {
            grid-column: 1 / -1;
            border-top: 1px solid var(--ds-border);
        }

        .ds-center {
            border-right: 0;
        }
    }

    @@media (max-width: 760px) {
        .decision-space {
            width: calc(100vw - 18px);
            border-radius: 8px;
        }

        .ds-dimensions-layout,
        .ds-workspace-grid,
        .ds-action-grid,
        .ds-scenario-controls,
        .ds-deploy-grid {
            display: block;
        }

        .ds-left,
        .ds-center {
            border-right: 0;
            border-bottom: 1px solid var(--ds-border);
        }

        .ds-form-grid,
        .ds-form-grid.two {
            grid-template-columns: repeat(2, minmax(130px, 1fr));
        }

        .ds-field,
        .ds-field.two-column,
        .ds-field.ds-span-2 {
            grid-column: span 1;
        }

        .ds-field.full {
            grid-column: 1 / -1;
        }

        .ds-action-card,
        .ds-scenario-value,
        .ds-deploy-stat {
            margin-bottom: 9px;
        }
    }
</style>

<style>
    html,
    body {
        background-color: #f1f3f5 !important;
        min-height: 100%;
    }
</style>

<div style="padding-top: 50px !important;">
    <div style="position: relative; max-width: 800px; margin: 0 auto;">
        <canvas id="netcanvas" width="800" height="70" style="display: block; width: 100%; height: 70px; border: none transparent;"></canvas>
        <div style="text-align: center;" class="table-block">
            <h2 class="ztitle" style="margin-top: -50px; white-space: nowrap;">
                Ai Decision Editor
            </h2>
        </div>
    </div>
</div>

<div style="
    max-width: 820px;
    margin: 32px auto;
